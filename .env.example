# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Azure Translator (Cognitive Services) free tier (F0)
# Create a free "Translator" resource in the Azure Portal, region can be "global"
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Optional: path to a Playwright storageState JSON (logged-in Taobao cookies).
# Strongly recommended - without it Taobao will often block/limit scraping
# and the reviews list will frequently be unavailable.
# Generate it once locally with: npx ts-node scripts/save-login-state.ts
TAOBAO_STORAGE_STATE_PATH=./storage/taobao-state.json

# Run the browser headless (true) or visible (false, useful for solving
# captchas manually the first time / refreshing login state)
PLAYWRIGHT_HEADLESS=true

# How long (in hours) a scraped+translated product stays cached before
# being re-scraped. Cache avoids hammering Taobao and avoids re-spending
# Azure Translator free-tier quota on repeat requests for the same item.
CACHE_TTL_HOURS=12
