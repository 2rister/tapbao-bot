# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: restricts the /restart button to this Telegram numeric user id
# (get yours from @userinfobot). Leave unset to disable /restart entirely.
TELEGRAM_OWNER_ID=

# Best data quality: Apify's "Taobao Tmall Product Scraper" actor
# (zen-studio/taobao-search-scraper on the Apify Store). Pay-per-event,
# roughly $0.5-0.6 per lookup with reviews - returns the full photo gallery
# and real customer reviews, unlike the two options below. Only used when
# the shared message includes the product title in Chinese brackets
# (「...」), since the actor only supports keyword search, not direct item
# id/URL lookup. Get a token from https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_ACTOR_ID=PsAKYWM55HG4AHXjK
APIFY_MAX_REVIEWS=5
APIFY_LOG_PATH=./storage/logs/apify.jsonl

# Recommended fallback: parse.bot's Taobao API (https://parse.bot/marketplace
# - search "Taobao API"). Free tier: 100 requests/month. Fetches product data
# from a Chinese vantage point, avoiding both Taobao's overseas-IP block and
# the need for a logged-in browser session - but often only returns 1
# photo/review per listing. Tried when Apify isn't configured or has no
# title to search with.
PARSEBOT_API_KEY=

# Azure Translator (Cognitive Services) free tier (F0)
# Create a free "Translator" resource in the Azure Portal, region can be "global"
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Persistent Chromium profile directory: cookies/login persist here across
# requests and bot restarts, and the browser process is reused between
# requests instead of relaunching for every message.
# Log in once with: npx ts-node scripts/save-login-state.ts
# Strongly recommended - without a login Taobao will often block/limit
# scraping and the reviews list will frequently be unavailable.
TAOBAO_PROFILE_DIR=./storage/taobao-profile

# Run the browser headless (true) or visible (false, useful for solving
# captchas manually the first time / refreshing login state)
PLAYWRIGHT_HEADLESS=true

# How long (in hours) a scraped+translated product stays cached before
# being re-scraped. Cache avoids hammering Taobao and avoids re-spending
# Azure Translator free-tier quota on repeat requests for the same item.
CACHE_TTL_HOURS=12
